{
  "name": "realty-demo-frontend",
  "description": "Web app for the Brix & Hart platform",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config ./webpack.config.ts --mode production",
    "lint:types": "tsc",
    "lint": "eslint . --config ../eslint.config.js",
    "lint:fix": "eslint . --config ../eslint.config.js --fix",
    "format": "prettier './**/*.{css,ts,tsx}' --no-config --write",
    "format:check": "prettier './**/*.{css,ts,tsx}' --no-config --check --ignore-path",
    "format:file": "prettier $1 --no-config --write"
  },
  "author": "Canva Pty Ltd.",
  "license": "SEE LICENSE IN LICENSE.md in root directory",
  "private": true,
  "dependencies": {
    "@canva/connect-api-ts": "*",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@realty-demo/shared-models": "*",
    "axios": "1.20.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@svgr/webpack": "8.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack": "5.28.5",
    "css-loader": "7.1.5",
    "cssnano": "7.1.9",
    "esbuild-register": "3.6.0",
    "postcss": "8.5.31",
    "postcss-loader": "8.2.1",
    "prettier": "3.9.10",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.7"
  }
